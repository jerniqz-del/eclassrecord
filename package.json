    "test:database-future-proof": "node scripts/test-database-future-proof.js",
    "test:backup-recovery": "node scripts/test-backup-recovery.js",
    "test:shared-folder-sync": "node scripts/test-shared-folder-sync.js",
    "test:teacher-tools": "node scripts/test-teacher-tools.js",
    "test:obfuscation-isolation": "node scripts/test-obfuscation-isolation.js",
    "test:learner-birthdate": "node scripts/test-learner-birthdate.js",
    "test:learner-avatars": "node scripts/test-learner-avatars.js",
    "test:usage-analytics": "node scripts/test-usage-analytics.js",
    "test:auto-updater": "node scripts/test-auto-updater.js",
    "test:performance-mode": "node scripts/test-performance-mode.js",
    "test:admin-auth": "node scripts/test-admin-auth.js",
    "test:admin-test-mode": "node scripts/test-admin-test-mode.js",
    "test:admin-mock-files": "node scripts/test-admin-mock-file-workflow.js",
    "test:advisory-data": "node scripts/test-advisory-data.js",
    "test:special-program": "node scripts/test-special-program.js",
    "test:senior-high": "node scripts/test-senior-high.js",
    "test:record-layout": "node scripts/test-record-layout.js",
    "test:attendance-pdf-print": "node scripts/test-attendance-pdf-print.js",
    "test:advisory-compatibility": "node scripts/test-advisory-compatibility.js",
    "test:advisory-dashboard": "node scripts/test-advisory-dashboard.js",
    "test:advisory-roster": "node scripts/test-advisory-roster.js",
    "test:grade-transfer": "node scripts/test-grade-transfer.js",
    "test:adviser-grade-permission": "node scripts/test-adviser-grade-permission.js",
    "test:grade-conflicts": "node scripts/test-grade-conflicts.js",
    "test:advisory-backup": "node scripts/test-advisory-backup.js",
    "test:advisory-e2e": "node scripts/test-advisory-e2e.js",
    "test:advisory-redesign": "node scripts/test-advisory-redesign.js",
    "test:link-preview": "node scripts/test-link-preview.js",
    "test:ui-regressions": "node scripts/test-ui-regressions.js",
    "smoke:offline": "electron . --offline-smoke-test",
