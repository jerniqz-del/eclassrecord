{
  "name": "eclass-record",
  "version": "1.6.3",
  "description": "Local, teacher-owned class record for DepEd three-term and legacy grading workflows",
  "author": "E-Class Record App",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerniqz-del/eclassrecord.git"
  },
  "main": "src/main/main.js",
  "allowScripts": {
    "electron@33.4.11": true
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run test:database-future-proof && npm run test:learner-birthdate && npm run test:admin-auth && npm run test:admin-test-mode && npm run test:admin-mock-files && npm run test:advisory-data && npm run test:special-program && npm run test:senior-high && npm run test:record-layout && npm run test:advisory-compatibility && npm run test:advisory-dashboard && npm run test:advisory-roster && npm run test:grade-transfer && npm run test:adviser-grade-permission && npm run test:grade-conflicts && npm run test:advisory-backup && npm run test:advisory-e2e && npm run test:advisory-redesign",
    "test:database-future-proof": "node scripts/test-database-future-proof.js",
    "test:learner-birthdate": "node scripts/test-learner-birthdate.js",
    "test:admin-auth": "node scripts/test-admin-auth.js",
    "test:admin-test-mode": "node scripts/test-admin-test-mode.js",
    "test:admin-mock-files": "node scripts/test-admin-mock-file-workflow.js",
    "test:advisory-data": "node scripts/test-advisory-data.js",
    "test:special-program": "node scripts/test-special-program.js",
    "test:senior-high": "node scripts/test-senior-high.js",
    "test:record-layout": "node scripts/test-record-layout.js",
    "test:advisory-compatibility": "node scripts/test-advisory-compatibility.js",
    "test:advisory-dashboard": "node scripts/test-advisory-dashboard.js",
    "test:advisory-roster": "node scripts/test-advisory-roster.js",
    "test:grade-transfer": "node scripts/test-grade-transfer.js",
    "test:adviser-grade-permission": "node scripts/test-adviser-grade-permission.js",
    "test:grade-conflicts": "node scripts/test-grade-conflicts.js",
    "test:advisory-backup": "node scripts/test-advisory-backup.js",
    "test:advisory-e2e": "node scripts/test-advisory-e2e.js",
    "test:advisory-redesign": "node scripts/test-advisory-redesign.js",
    "smoke:offline": "electron . --offline-smoke-test",
    "build": "node scripts/build-obfuscated.js --win",
    "publish": "node scripts/build-obfuscated.js --win --publish always",
    "release": "node scripts/release.js",
    "safe-commit": "node scripts/safe-commit.js",
    "stable-release": "node scripts/stable-release.js",
    "update-checkpoint": "node scripts/update-checkpoint.js",
    "community-relay": "node community-relay/server.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "jsqr": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
