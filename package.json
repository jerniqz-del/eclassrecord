{
  "name": "eclass-record",
  "version": "1.4.6",
  "description": "Local, teacher-owned class record for DepEd three-term and legacy grading workflows",
  "author": "E-Class Record App",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerniqz-del/eclassrecord.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run test:advisory-data && npm run test:advisory-dashboard",
    "test:advisory-data": "node scripts/test-advisory-data.js",
    "test:advisory-dashboard": "node scripts/test-advisory-dashboard.js",
    "build": "node scripts/build-obfuscated.js --win",
    "publish": "node scripts/build-obfuscated.js --win --publish always",
    "release": "node scripts/release.js",
    "safe-commit": "node scripts/safe-commit.js",
    "stable-release": "node scripts/stable-release.js",
    "update-checkpoint": "node scripts/update-checkpoint.js",
    "community-relay": "node community-relay/server.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
